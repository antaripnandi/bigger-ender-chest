  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.biggerenderchest.BiggerEnderChest"
    ]
  },
  "mixins": [
    "biggerenderchest.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${minecraft_version}"
  }
}
